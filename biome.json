{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!playwright-report",
      "!test-results",
      "!user-stories"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "useExhaustiveSwitchCases": "error",
        "useExplicitType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "useAwait": "error"
      },
      "style": {
        "noEnum": "error",
        "noMagicNumbers": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useConst": "error",
        "useDefaultSwitchClause": "error",
        "useExportType": "error",
        "useFilenamingConvention": "error",
        "useImportType": "error",
        "useNamingConvention": "error",
        "useReadonlyClassProperties": "error",
        "useTemplate": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
