{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "pnpm lint:biome && pnpm lint:md",
    "lint:biome": "biome check",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2",
    "lint:fix": "biome check --write && prettier --write \"**/*.md\" && markdownlint-cli2 --fix",
    "format": "biome format --write",
    "prepare": "husky",
    "format:md": "prettier --write \"**/*.md\""
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  }
}
