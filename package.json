{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "biome format --write",
    "format:md": "prettier --write \"**/*.md\"",
    "lint": "pnpm lint:biome && pnpm lint:md",
    "lint:biome": "biome check",
    "lint:fix": "biome check --write && prettier --write \"**/*.md\" && markdownlint-cli2 --fix",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.0"
  }
}
